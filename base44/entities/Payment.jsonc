{
  "name": "Payment",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "description": "Valor do pagamento"
    },
    "currency": {
      "type": "string",
      "description": "Moeda do pagamento (ex: BRL)"
    },
    "status": {
      "type": "string",
      "description": "Status do pagamento (ex: approved, pending, declined)"
    },
    "transactionId": {
      "type": "string",
      "description": "ID da transa\u00e7\u00e3o no CinqPay"
    },
    "userId": {
      "type": "string",
      "description": "ID do usu\u00e1rio que fez o pagamento"
    },
    "plan": {
      "type": "string",
      "description": "Plano adquirido (ex: FREE, NOVATO, MESTRE, CABULOSO)"
    },
    "paymentMethod": {
      "type": "string",
      "description": "M\u00e9todo de pagamento (ex: credit_card, pix)"
    },
    "pixCode": {
      "type": "string",
      "description": "C\u00f3digo PIX (copia e cola)"
    },
    "pixQrCode": {
      "type": "string",
      "description": "URL do QR Code PIX"
    }
  },
  "required": [
    "amount",
    "currency",
    "status",
    "transactionId",
    "userId",
    "plan",
    "paymentMethod"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}